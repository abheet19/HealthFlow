# Docker Compose reads these two development-only values. Change both before
# using HealthFlow outside an isolated synthetic test machine.
HEALTHFLOW_DB_PASSWORD=healthflow-local-db
HEALTHFLOW_ACCESS_CODE=synthetic-local-test
HEALTHFLOW_DEFAULT_CLINIC_ID=demo
HEALTHFLOW_DEFAULT_USER_ID=demo-user

# Multi-clinic deployments replace the legacy code above with an exact
# clinic -> user -> secret map. Keep this in runtime secrets, never source.
# HEALTHFLOW_IDENTITIES_JSON={"clinic-a":{"it-station":"replace-me"},"clinic-b":{"it-station":"replace-me-too"}}

# Direct backend development uses the POSTGRES_* contract below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=healthflow-local-db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=doctor_reports
HEALTHFLOW_REQUIRE_ACCESS_CODE=true
CORS_ORIGINS=http://127.0.0.1:5179

# Cloud SQL deployments also set CLOUD_RUN=true and INSTANCE_CONNECTION_NAME.
CLOUD_RUN=false
